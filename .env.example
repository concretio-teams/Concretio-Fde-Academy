# Copy to .env for local use (never commit .env).
# Long random string used to sign login cookies. Required in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Neon Postgres connection string (use the pooled one). Leave empty locally to use a JSON file in .data/
# (do not rely on that in production).
DATABASE_URL=

# Google sign in is the only way to sign in.
# Google Cloud Console > APIs and Services > Credentials > Create credentials > OAuth client ID > Web application.
# Authorised redirect URI: <APP_URL>/api/auth/google/callback  (add one per environment)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public address of the app, used for the Google redirect. Local: http://localhost:5173
APP_URL=

# Comma separated email domains allowed to sign in. Empty means any Google account.
ALLOWED_EMAIL_DOMAINS=concret.io

# Comma separated emails that can open the Cohort page (#/admin). Empty means nobody.
ADMIN_EMAILS=

# Set to "disable" only if your Postgres does not use TLS.
# PGSSL=disable
