{
  "name": "claude-code-academy",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:full": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "preview": "vite preview",
    "db:migrate": "node scripts/migrate-db.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:api": "tsx scripts/api-smoke.ts",
    "test:sf-path": "tsx scripts/check-sf-path.ts",
    "dev:staging": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch --env-file=.env.staging server/index.ts\""
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "express": "4.19.2",
    "jose": "5.9.6",
    "jsonwebtoken": "9.0.2",
    "mermaid": "10.9.8",
    "pg": "8.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "22.5.0",
    "@types/pg": "8.11.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "concurrently": "8.2.2",
    "typescript": "5.5.4",
    "vite": "5.4.2"
  }
}
